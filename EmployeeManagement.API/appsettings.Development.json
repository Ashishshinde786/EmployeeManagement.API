{
  // Stores database connection details.
  "ConnectionStrings": {
    // Connects the application to SQL Server LocalDB.
    // Server: SQL Server instance.
    // Database: Name of the database.
    // Trusted_Connection=True: Uses Windows authentication.
    // TrustServerCertificate=True: Trusts the SQL Server certificate.
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EmployeeDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  // Configuration used to generate and validate JWT tokens.
  "Jwt": {
    // Identifies the application that issues the JWT.
    "Issuer": "EmployeeManagement.API",

    // Identifies the intended recipient of the JWT.
    "Audience": "EmployeeManagement.Client",

    // Token validity period in minutes.
    // After 60 minutes, the token expires.
    "ExpiryMinutes": 60
  },

  // Rate-limiting configuration.
  "RateLimit": {
    // Allows up to 5 requests per minute under the
    // "auth" rate-limiting policy configured in Program.cs.
    "AuthPermitPerMinute": 5
  },

  // Configures application logging.
  "Logging": {
    "LogLevel": {
      // Logs Information, Warning, Error, Critical, and higher-severity events.
      "Default": "Information",

      // Reduces Microsoft.AspNetCore framework logs to Warning and above.
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Allows requests from any host name.
  // Production applications may need a more restrictive setting.
  "AllowedHosts": "*"
}